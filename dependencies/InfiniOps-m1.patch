diff --git a/src/torch/encoder_stream.h b/src/torch/encoder_stream.h
new file mode 100644
index 0000000..f88c4d6
--- /dev/null
+++ b/src/torch/encoder_stream.h
@@ -0,0 +1,24 @@
+#pragma once
+#include "torch/c10.h"
+#ifdef WITH_NVIDIA
+#include "torch/nvidia/c10.h"
+#endif
+#ifdef WITH_CAMBRICON
+#include "torch/cambricon/c10.h"
+#endif
+#ifdef WITH_ASCEND
+#include "torch/ascend/c10.h"
+#endif
+
+namespace infini::ops {
+template <Device::Type kDev, typename Fn>
+void WithEncoderStream(void* stream, int device_index, Fn&& fn) {
+  if constexpr (kDev == Device::Type::kNvidia || kDev == Device::Type::kCambricon || kDev == Device::Type::kAscend) {
+    const typename C10<kDev>::StreamGuard guard{
+        C10<kDev>::GetStreamFromExternal(stream, device_index)};
+    fn();
+  } else {
+    fn();
+  }
+}
+}
diff --git a/src/torch/ops/cast/cast.cc b/src/torch/ops/cast/cast.cc
new file mode 100644
index 0000000..b1d004f
--- /dev/null
+++ b/src/torch/ops/cast/cast.cc
@@ -0,0 +1,28 @@
+#include "torch/ops/cast/cast.h"
+#include "torch/tensor_.h"
+#include "torch/encoder_stream.h"
+
+namespace infini::ops {
+template <Device::Type kDev>
+void Operator<Cast, kDev, 8>::operator()(const Tensor input, Tensor out) const {
+  WithEncoderStream<kDev>(stream_, out.device().index(), [&] {
+    auto x = ToAtenTensor<kDev>(const_cast<void*>(input.data()), input.shape(),
+        input.strides(), input.dtype(), input.device().index());
+    auto y = ToAtenTensor<kDev>(out.data(), out.shape(), out.strides(),
+        out.dtype(), out.device().index());
+    y.copy_(x);
+  });
+}
+#ifdef WITH_CPU
+template class Operator<Cast, Device::Type::kCpu, 8>;
+#endif
+#ifdef WITH_NVIDIA
+template class Operator<Cast, Device::Type::kNvidia, 8>;
+#endif
+#ifdef WITH_CAMBRICON
+template class Operator<Cast, Device::Type::kCambricon, 8>;
+#endif
+#ifdef WITH_ASCEND
+template class Operator<Cast, Device::Type::kAscend, 8>;
+#endif
+}
